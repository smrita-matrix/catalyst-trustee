# ============================================================
#  Laravel — ROOT .htaccess
#  Sits next to app/  vendor/  public/  artisan
#
#  Forwards every request into public/ so the site works at
#  /catalyst-trustee/ instead of /catalyst-trustee/public/.
#  Works at any folder depth and on any host.
# ============================================================

# Never show a directory listing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header through (needed for logins / API tokens)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Send everything into public/.
    # Skip requests that already point at public/, otherwise the rule
    # would re-apply to its own output and produce public/public/...
    RewriteCond %{REQUEST_URI} !/public(/|$)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Safety net: block direct access to sensitive files
# (matters only if mod_rewrite is ever disabled)
<FilesMatch "^(\.env|\.env\..*|composer\.(json|lock)|package\.json|artisan|phpunit\.xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ============================================================
#  Upload limits
#
#  The default on most shared hosting is 2M, which refuses the
#  PDFs and images uploaded through the dashboard before the
#  site ever sees them.
#
#  These lines apply only where PHP runs as an Apache module.
#  On CGI/FastCGI hosting - which cPanel normally uses - Apache
#  rejects them outright, so they are guarded: without the guard
#  the whole site returns a 500 error. public/.user.ini covers
#  that case instead.
# ============================================================
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 72M
    php_value max_file_uploads 50
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 72M
    php_value max_file_uploads 50
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 72M
    php_value max_file_uploads 50
    php_value memory_limit 256M
</IfModule>
